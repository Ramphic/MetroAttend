# Firebase Configuration
# Replace these values with your credentials from the Firebase Console (Project Settings -> General -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Designated Single Admin Email
# The user who signs in with this email will have exclusive access to the Admin Dashboard
VITE_ADMIN_EMAIL=admin@metroworks.gov.gh
